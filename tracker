#!/usr/bin/env bash
# Dev control script for the expense tracker: manages Postgres and Ollama
# (Docker), plus backend (Spring Boot) and frontend (Vite) as background processes.
#
# Processes are tracked by the port they listen on (8080 / 5173), not by PID.
# On Windows, bash's `$!` under Git Bash/MSYS does not reliably correspond to
# the real Win32 PID of a forked JVM/Node child, so PID-based tracking silently
# fails to kill everything. Port-based lookup via `netstat` + `taskkill /T` is
# what actually works here.
#
# Backend/frontend are launched via PowerShell's Start-Process rather than
# bash `&` backgrounding: a plain `&` job stays attached to the invoking
# console on Windows, so closing that terminal (or Ctrl+C) kills it even
# though it was backgrounded. Start-Process creates a genuinely independent
# process that survives the shell that launched it.
#
# Usage:
#   ./tracker start                     Start Postgres + backend + frontend
#   ./tracker stop                      Stop everything
#   ./tracker status                    Show what's running
#   ./tracker logs [backend|frontend]   Tail logs (default: both)

set -u

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

WIN_ROOT="$(pwd -W)"
LOG_DIR="$ROOT_DIR/.tracker/logs"
BACKEND_PORT=8080
FRONTEND_PORT=5173
OLLAMA_MODEL="llama3.2:3b"

mkdir -p "$LOG_DIR"

start_detached() {
  local file_path="$1"
  local args="$2"
  local work_dir="$3"
  local log_name="$4"
  powershell.exe -NoProfile -Command \
    "Start-Process -FilePath '${file_path}' -ArgumentList '${args}' -WorkingDirectory '${work_dir}' -WindowStyle Hidden -RedirectStandardOutput '${WIN_ROOT}/.tracker/logs/${log_name}.log' -RedirectStandardError '${WIN_ROOT}/.tracker/logs/${log_name}.err.log'" \
    >/dev/null 2>&1
}

port_pids() {
  local port="$1"
  netstat -ano 2>/dev/null | grep -E "LISTENING" | grep -E ":${port}[[:space:]]" | awk '{print $NF}' | sort -u
}

is_port_open() {
  [ -n "$(port_pids "$1")" ]
}

kill_port() {
  local port="$1"
  local name="$2"
  local pids
  pids="$(port_pids "$port")"
  if [ -z "$pids" ]; then
    echo "==> $name not running (nothing listening on :$port)."
    return
  fi
  local pid
  for pid in $pids; do
    echo "==> Stopping $name (pid $pid, port $port)..."
    taskkill //PID "$pid" //T //F >/dev/null 2>&1
  done
}

cmd_start() {
  echo "==> Starting Postgres + Ollama (docker compose)..."
  if ! docker compose up -d; then
    echo "Could not start Postgres/Ollama. Is Docker Desktop running?"
    exit 1
  fi

  echo "==> Waiting for Postgres to accept connections..."
  local ready=false
  for _ in $(seq 1 30); do
    if docker exec expense-tracker-db pg_isready -U expense_user -d expense_tracker >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 1
  done
  if [ "$ready" = false ]; then
    echo "Postgres did not become ready in time. Check 'docker logs expense-tracker-db'."
    exit 1
  fi
  echo "    Postgres is ready."

  echo "==> Waiting for Ollama to accept connections..."
  ready=false
  for _ in $(seq 1 30); do
    if docker exec expense-tracker-ollama ollama list >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 1
  done
  if [ "$ready" = false ]; then
    echo "Ollama did not become ready in time. Check 'docker logs expense-tracker-ollama'."
    exit 1
  fi
  echo "    Ollama is ready."

  if docker exec expense-tracker-ollama ollama list 2>/dev/null | grep -q "^${OLLAMA_MODEL}"; then
    echo "==> Model $OLLAMA_MODEL already pulled."
  else
    echo "==> Pulling $OLLAMA_MODEL (first time only, ~2GB download)..."
    docker exec expense-tracker-ollama ollama pull "$OLLAMA_MODEL"
  fi

  if is_port_open "$BACKEND_PORT"; then
    echo "==> Backend already running on :$BACKEND_PORT."
  else
    echo "==> Starting backend on :$BACKEND_PORT..."
    start_detached "${WIN_ROOT}/backend/mvnw.cmd" "spring-boot:run" "${WIN_ROOT}/backend" "backend"
  fi

  if is_port_open "$FRONTEND_PORT"; then
    echo "==> Frontend already running on :$FRONTEND_PORT."
  else
    echo "==> Starting frontend on :$FRONTEND_PORT..."
    start_detached "npm.cmd" "run dev" "${WIN_ROOT}/frontend" "frontend"
  fi

  echo ""
  echo "Backend log:  tail -f .tracker/logs/backend.log   (or ./tracker logs backend)"
  echo "Frontend log: tail -f .tracker/logs/frontend.log  (or ./tracker logs frontend)"
  echo "Run './tracker stop' when you're done."
}

cmd_stop() {
  kill_port "$BACKEND_PORT" "backend"
  kill_port "$FRONTEND_PORT" "frontend"
  echo "==> Stopping Postgres + Ollama (docker compose)..."
  docker compose down
}

cmd_status() {
  if is_port_open "$BACKEND_PORT"; then
    echo "backend:   running on :$BACKEND_PORT (pid $(port_pids "$BACKEND_PORT" | tr '\n' ' '))"
  else
    echo "backend:   stopped"
  fi
  if is_port_open "$FRONTEND_PORT"; then
    echo "frontend:  running on :$FRONTEND_PORT (pid $(port_pids "$FRONTEND_PORT" | tr '\n' ' '))"
  else
    echo "frontend:  stopped"
  fi
  docker compose ps postgres ollama 2>/dev/null
}

cmd_logs() {
  case "${1:-all}" in
    backend) tail -f "$LOG_DIR/backend.log" "$LOG_DIR/backend.err.log" ;;
    frontend) tail -f "$LOG_DIR/frontend.log" "$LOG_DIR/frontend.err.log" ;;
    *) tail -f "$LOG_DIR"/*.log ;;
  esac
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  logs) shift; cmd_logs "${1:-}" ;;
  *)
    echo "Usage: ./tracker {start|stop|status|logs [backend|frontend]}"
    exit 1
    ;;
esac
